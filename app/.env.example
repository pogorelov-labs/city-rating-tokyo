# Environment for the Next.js app. Copy to .env.local for local development.
# In production these are set in Coolify. NEXT_PUBLIC_* values are inlined at
# BUILD time, so in Coolify they must be marked as build variables.
# Never commit real values: this file is the only .env* that git tracks.

# --- Base map --------------------------------------------------------------
# CARTO basemaps key (free, non-commercial up to 5M tiles/month):
# https://carto.com/basemaps/apikey — without it the map falls back to
# OpenStreetMap tiles (see src/lib/basemap.ts). Public by design: it appears
# in every tile URL.
NEXT_PUBLIC_CARTO_BASEMAPS_KEY=

# --- Analytics (Umami) — optional; the tag is omitted when unset -------------
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Server-only: feedback and API-key forms write to NocoDB -----------------
NOCODB_API_URL=https://nocodb.pogorelov.dev
NOCODB_API_TOKEN=
NOCODB_TABLE_ID=
NOCODB_API_KEYS_TABLE_ID=

# --- Optional --------------------------------------------------------------
# Extra origin accepted by the public POST routes in development,
# e.g. http://localhost:3000 (src/lib/api-security.ts).
ALLOWED_DEV_ORIGIN=
# Sitemap base URL (next-sitemap.config.js); defaults to the production site.
SITE_URL=
