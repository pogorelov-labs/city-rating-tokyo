  "_meta": {
    "updated": "2026-09",
    "rent": {
      "unit": "THB per month",
      "definition": "Typical asking rent for a ~30-35 m² 1-bedroom condo (rent_1br) and a ~60-70 m² 2-bedroom condo (rent_2br) in the district's main residential corridors. Not a statistical median.",
      "method": "Researcher estimate. Bangkok has no open rent statistics at district level and the listing portals (Hipflat, FazWaz, DDproperty) block automated access, so values are calibrated by hand against published aggregates: city-wide 1-bed average ~฿22.9k (PropertyScout listing average, skewed to central supply); prime BTS corridor (Asok, Phrom Phong, Thong Lo, Chit Lom) ~฿800-1,200/m²; On Nut / Bang Na / Rama 9 ~฿10-15k for ~30 m²; Bang Kapi ~฿440/m². Outer districts with little condo supply are anchored to townhouse/apartment rents.",
      "confidence": "editorial",
      "calibration_sources": [
        "https://propertyscout.co.th/en/bangkok/rentals/condo/",
        "https://propertysights.com/blog/condo-rent-bangkok",
        "https://www.bangkok-housing.com/condo-apartment/rent/district/khlong-toei-district/"
      ]
    },
    "safety": {
      "scale": "1-10, higher = safer, relative within Bangkok",
      "method": "Researcher assessment. The Royal Thai Police publishes no open, district-level crime statistics, so this is a judgement from reported patterns: petty theft and scams around tourist and nightlife strips (Khao San, Patpong, Nana, Soi Cowboy, Pratunam, Ratchada), clustered incidents around the Khlong Toei port communities and Din Daeng flats, versus quiet residential and government districts. It does not cover road safety, the city's largest real risk.",
      "confidence": "editorial"
    },
    "aliases": "Neighbourhood, road and landmark names people use instead of the khet name. Search matches them; they also let rail-station names resolve to the district."
  },
